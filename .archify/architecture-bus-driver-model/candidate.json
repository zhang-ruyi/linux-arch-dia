  "cards": [
    {
      "dot": "cyan",
      "title": "三个核心对象",
      "items": [
        "bus_type 通过 subsys_private 持有设备与驱动的 kset",
        "device_driver 通过 driver_private 持有 kobject",
        "device 直接内嵌 kobject，统一接入 sysfs 对象模型"
      ]
    },
    {
      "dot": "emerald",
      "title": "注册与绑定",
      "items": [
        "driver_register() 把驱动加入总线，并触发 driver_attach()",
        "__driver_attach() 对每个设备尝试匹配",
        "driver_probe_device() → really_probe() → drv->probe 完成绑定"
      ]
    },
