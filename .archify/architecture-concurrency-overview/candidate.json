  "cards": [
    {
      "dot": "cyan",
      "title": "短临界区（不可睡眠）",
      "items": [
        "atomic_t 用于单个变量的原子读改写，不需要锁",
        "spinlock_t 自旋等待，适合很短且不能睡眠的临界区",
        "中断上下文只能使用不会睡眠的原语"
      ]
    },
    {
      "dot": "emerald",
      "title": "可睡眠与读多写少",
      "items": [
        "mutex 在进程上下文睡眠等待，临界区可以较长",
        "rwlock_t 允许多个读者并发，写者独占",
        "seqlock_t 用序列计数检测读写竞争，适合一致快照；RCU 读侧几乎零开销，写侧延迟回收"
      ]
    },
    {
      "dot": "amber",
      "title": "统计与延迟工作",
      "items": [
        "per-CPU 为每个 CPU 维护副本，累加时无需跨 CPU 锁",
        "workqueue 把工作推迟到进程上下文，允许睡眠",
        "选择顺序通常是：先看能否无锁统计，再看临界区长度与是否可睡眠"
      ]
    }
  ]
}
