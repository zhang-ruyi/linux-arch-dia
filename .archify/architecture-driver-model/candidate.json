  "cards": [
    {
      "dot": "cyan",
      "title": "对象模型",
      "items": [
        "kobject 提供引用计数、sysfs 目录与 uevent",
        "kset 是同类 kobject 的集合，自身也内嵌一个 kobject",
        "kobject_add() 通过 create_dir() 在 sysfs 建立目录"
      ]
    },
    {
      "dot": "emerald",
      "title": "注册",
      "items": [
        "device_register() = device_initialize() + device_add()",
        "device_add() 依次调用 bus_add_device() 与 bus_probe_device()",
        "driver_register() 把驱动交给 bus_add_driver()"
      ]
    },
    {
      "dot": "violet",
      "title": "匹配",
      "items": [
        "bus_type.match(dev, drv) 返回正数才视为匹配",
        "driver_match_device() 在总线未提供 match 时默认返回 1",
        "匹配成功后进入 really_probe() 调用驱动 probe()"
      ]
    }
  ]
