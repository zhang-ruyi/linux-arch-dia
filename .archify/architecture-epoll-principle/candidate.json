    },
    {
      "dot": "emerald",
      "title": "回调驱动",
      "items": [
        "epoll_ctl(EPOLL_CTL_ADD) 经 ep_insert() 插入 rbr",
        "fd 就绪时 ep_poll_callback() 将其加入 rdllist",
        "回调同时唤醒等待队列 wq"
      ]
    },
    {
      "dot": "violet",
      "title": "等待与重查",
      "items": [
        "epoll_wait() 经 ep_poll() 检查 rdllist",
        "无事件时休眠在 wq 上",
        "被唤醒后再次检查 rdllist"
      ]
    },
