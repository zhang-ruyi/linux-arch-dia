  "cards": [
    {
      "dot": "cyan",
      "title": "磁盘布局",
      "items": [
        "superblock 记录块大小、块组数量、inode 数量与特性",
        "group descriptors 为每个块组给出块位图、inode 位图、inode 表位置",
        "inode table 存放 ext4_inode,i_block[15] 是 extent 树的根"
      ]
    },
    {
      "dot": "emerald",
      "title": "空间分配",
      "items": [
        "写路径先进入 page cache,延迟分配在回写时才真正分配块",
        "ext4_map_blocks 经 ext4_ext_map_blocks 查询 extent 树",
        "未映射区间由 mballoc 搜索块位图并分配物理块"
      ]
    },
    {
      "dot": "violet",
      "title": "JBD2 日志",
      "items": [
        "元数据修改先 jbd2_journal_get_write_access 取得写权限",
        "jbd2_journal_start 开启事务,commit 时统一写入日志",
        "ext4_getblk 把逻辑块映射为 buffer_head 后提交块设备"
      ]
    },
    {
      "dot": "slate",
      "title": "源码索引",
      "items": [
        "ext4_super_block—fs/ext4/ext4.h:1372",
        "ext4_group_desc—fs/ext4/ext4.h:402",
        "ext4_inode—fs/ext4/ext4.h:794",
        "ext4_extent / header—fs/ext4/ext4_extents.h:56,78",
        "ext4_map_blocks—fs/ext4/inode.c:772",
        "ext4_da_map_blocks—fs/ext4/inode.c:2033",
        "ext4_ext_map_blocks—fs/ext4/extents.c:4275",
        "ext4_mb_new_blocks—fs/ext4/mballoc.c:6228",
        "jbd2_journal_commit_transaction—fs/jbd2/commit.c:376"
      ]
    }
  ]
