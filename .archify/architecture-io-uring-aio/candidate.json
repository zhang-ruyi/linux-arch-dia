  "cards": [
    {
      "dot": "cyan",
      "title": "io_uring",
      "items": [
        "io_uring_setup 创建 SQ/CQ ring,应用 mmap 共享内存",
        "用户写 SQE,io_uring_enter 提交并收割 CQE",
        "IORING_SETUP_SQPOLL 由内核线程轮询 SQ,减少系统调用",
        "registered files/buffers 预注册资源,avoid 重复映射",
        "IORING_OP_URING_CMD 把命令透传给设备 ->uring_cmd()"
      ]
    },
    {
      "dot": "emerald",
      "title": "libaio",
      "items": [
        "io_setup 创建 kioctx 与 aio ring",
        "io_submit 提交 iocb,经 read_iter/write_iter 进入块层",
        "io_getevents 从完成环读取 io_event",
        "全部由 fs/aio.c 在内核实现,支持 preadv/pwritev 等命令"
      ]
    },
    {
      "dot": "violet",
      "title": "POSIX AIO",
      "items": [
        "glibc 在用户态维护线程池实现 POSIX 异步接口",
        "worker 线程执行阻塞的 pread/pwrite 系统调用",
        "内核不创建 AIO 上下文,也不使用 SQ/CQ 环",
        "该实现位于 glibc,不在本内核源码树内"
      ]
    },
    {
      "dot": "slate",
      "title": "源码索引",
      "items": [
        "io_uring_setup—io_uring/io_uring.c:3365",
        "io_uring_enter—io_uring/io_uring.c:2852",
        "io_uring_cmd—io_uring/uring_cmd.c:226",
        "SQ/CQ ABI—include/uapi/linux/io_uring.h:32,501",
        "io_setup/io_submit/io_getevents—fs/aio.c:1445,2150,2319",
        "iocb/io_event—include/uapi/linux/aio_abi.h:60,73"
      ]
    }
  ]
