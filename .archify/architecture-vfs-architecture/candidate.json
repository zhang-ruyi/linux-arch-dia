  "cards": [
    {
      "dot": "cyan",
      "title": "四大核心对象",
      "items": [
        "file 表示进程打开的文件，通过 file_operations 调用读写",
        "dentry 缓存路径分量到 inode 的映射",
        "inode 保存文件元数据，通过 inode_operations 完成目录查找等操作",
        "super_block 描述已挂载的文件系统，通过 super_operations 管理生命周期"
      ]
    },
    {
      "dot": "emerald",
      "title": "页缓存与底层",
      "items": [
        "file 与 inode 的读写都通过 address_space 接入页缓存",
        "页缓存最终把脏页或缺失页通过块设备层提交 I/O",
        "ext4 等具体文件系统通过 file_operations / inode_operations 落地实现"
      ]
    },
    {
      "dot": "slate",
      "title": "完整调用链(源码核实)",
      "items": [
        "do_file_open—fs/namei.c:5035",
        "path_openat—fs/namei.c:4996",
