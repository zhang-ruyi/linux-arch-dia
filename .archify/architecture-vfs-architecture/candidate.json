      "dot": "cyan",
      "title": "四大核心对象",
      "items": [
        "file 表示进程打开的文件，通过 file_operations 调用读写",
        "dentry 缓存路径分量到 inode 的映射",
        "inode 保存文件元数据，通过 inode_operations 完成目录查找等操作",
        "super_block 描述已挂载的文件系统，通过 super_operations 管理生命周期"
      ]
    },
