  "cards": [
    {
      "dot": "cyan",
      "title": "主循环",
      "items": [
        "NEW 只能经 CONNECTING 进入 LIVE,不能直接跳到 LIVE",
        "LIVE 是唯一可正常执行 I/O 的状态",
        "复位完成后必须重新经过 CONNECTING 才能回到 LIVE",
        "状态迁移由 nvme_change_ctrl_state 的允许表约束"
      ]
    },
    {
      "dot": "amber",
      "title": "超时与复位",
      "items": [
        "nvme_timeout 先 poll 队列,寻找可能漏掉的中断",
        "admin 队列命令或已 abort 的命令触发控制器复位",
        "普通 I/O 先发 abort 命令,再次超时才复位",
        "RESETTING 状态下超时返回 BLK_EH_RESET_TIMER 等待复位"
      ]
    },
    {
      "dot": "rose",
      "title": "删除与终结",
      "items": [
        "DELETING 与 DELETING_NOIO 都是不可恢复的删除阶段",
        "DEAD 表示设备已消失,链路无法继续",
        "最终命名空间在 DELETING_NOIO 阶段移除",
        "删除路径不会回到 LIVE"
      ]
    }
  ]
}