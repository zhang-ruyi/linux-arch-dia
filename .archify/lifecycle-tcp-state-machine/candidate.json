  "cards": [
    {
      "dot": "cyan",
      "title": "打开与关闭两条路径",
      "items": [
        "被动打开:CLOSED → LISTEN → SYN_RECV → ESTABLISHED",
        "LISTEN 收到 SYN 回 SYN+ACK,SYN_RECV 收到 ACK 后建立",
        "ESTABLISHED 收到 FIN 回 ACK 进入 CLOSE_WAIT",
        "主动关闭与被动关闭分别经过 FIN_WAIT / CLOSE_WAIT"
      ]
    },
    {
      "dot": "amber",
      "title": "同时事件",
      "items": [
        "同时打开:SYN_SENT 收到 SYN 进入 SYN_RECV",
        "同时关闭:FIN_WAIT_1 收到 FIN 进入 CLOSING"
      ]
    },
    {
      "dot": "violet",
      "title": "终止与复用",
      "items": [
        "LAST_ACK 收到 ACK 后回到 CLOSED",
        "TIME_WAIT 等待 2MSL 后回到 CLOSED",
        "SYN_RECV 收到 RST 可退回 LISTEN"
      ]
    }
  ]
}