  "cards": [
    {
      "dot": "emerald",
      "title": "关键路径",
      "items": [
        "device_add() → bus_add_device() → bus_probe_device()",
        "device_initial_probe() → __device_attach() → bus_for_each_drv()",
        "driver_probe_device() → really_probe() → call_driver_probe()"
      ]
    },
    {
      "dot": "violet",
      "title": "匹配规则",
      "items": [
        "bus_type.match() 返回正数才继续绑定",
        "driver_match_device() 在总线没有 match 时默认返回 1",
        "match 返回 -EPROBE_DEFER 时设备进入延迟探测队列"
      ]
    },
    {
      "dot": "orange",
      "title": "devres 说明",
      "items": [
        "本版本的 really_probe() 不调用 devres_open_group()",
        "probe 失败与解绑都经 device_unbind_cleanup() → devres_release_all()",
        "devres group 由 component 等调用者显式打开 (drivers/base/component.c)"
      ]
    }
  ]
