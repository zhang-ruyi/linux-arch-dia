  "cards": [
    {
      "dot": "cyan",
      "title": "调用主链",
      "items": [
        "用户进程经 SYSCALL_DEFINE6(mmap_pgoff) 进入 ksys_mmap_pgoff",
        "ksys_mmap_pgoff 对非匿名映射执行 fget(fd),随后调用 vm_mmap_pgoff",
        "do_mmap 校验后交给 mmap_region,由 __mmap_new_vma 创建 vm_area_struct"
      ]
    },
    {
      "dot": "emerald",
      "title": "映射类型分支",
      "items": [
        "匿名映射调用 vma_set_anonymous,物理页留待缺页分配",
        "共享匿名 MAP_SHARED 调用 shmem_zero_setup",
        "文件映射经 mmap_file 与 vfs_mmap 调用 file->f_op->mmap"
      ]
    },
    {
      "dot": "slate",
      "title": "完整调用链(源码核实)",
      "items": [
        "ksys_mmap_pgoff—mm/mmap.c:581",
        "vm_mmap_pgoff — mm/util.c:565",
        "do_mmap—mm/mmap.c:338",
        "mmap_region—mm/vma.c:3147",
        "__mmap_region—mm/vma.c:3048",
        "__mmap_new_vma—mm/vma.c:2724",
        "分支:文件映射 __mmap_new_file_vma—mm/vma.c:2642",
        "mmap_file—mm/internal.h:249",
        "vfs_mmap—include/linux/fs.h:2065",
        "file->f_op->mmap—include/linux/fs.h:2070"
      ]
    }
  ]
