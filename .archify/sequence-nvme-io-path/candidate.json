  "cards": [
    {
      "dot": "emerald",
      "title": "提交路径",
      "items": [
        "read()/write() 经 ksys_* 进入 vfs_read，并由文件的 read_iter/write_iter 下发",
        "普通文件走 ext4_file_read_iter，裸块设备走 blkdev_read_iter/write_iter",
        "submit_bio_noacct 进入 blk-mq，分配 request 后由 nvme_queue_rq 处理"
      ]
    },
    {
      "dot": "cyan",
      "title": "NVMe 提交",
      "items": [
        "nvme_setup_cmd 生成 64 字节 SQE，nvme_sq_copy_cmd 写入主机 SQ",
        "nvme_write_sq_db 通过 writel(sq_tail) 写 BAR 门铃通知控制器",
        "控制器 DMA 读取 SQE 并执行，完成后写 CQE 并触发 MSI-X"
      ]
    },
    {
      "dot": "violet",
      "title": "完成路径",
      "items": [
        "nvme_irq → nvme_handle_cqe 用 command_id 找回 request",
        "nvme_complete_rq → nvme_end_req → blk_mq_end_request 逐层回收",
        "bio_endio 结束 bio，read()/write() 将字节数返回用户态"
      ]
    }
  ]
}
