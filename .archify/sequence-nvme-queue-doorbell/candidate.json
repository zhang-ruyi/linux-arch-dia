  "cards": [
    {
      "dot": "cyan",
      "title": "提交侧门铃",
      "items": [
        "nvme_queue_rq 在 sq_lock 下调用 nvme_sq_copy_cmd，把 64B SQE 拷入主机 SQ",
        "sq_tail 自增后由 nvme_write_sq_db 写门铃；批量提交时只写一次",
        "writel(sq_tail, q_db) 落在 BAR 映射的 SQ tail doorbell 上"
      ]
    },
    {
      "dot": "emerald",
      "title": "队列对生命周期",
      "items": [
        "nvme_alloc_queue 分配 CQ 与 SQ 命令区，并把 DMA 地址写入 ASQ/ACQ",
        "q_depth 取 min(NVME_CAP_MQES+1, io_queue_depth)，io_queue_depth 默认 1024",
        "admin queue 深度固定为 NVME_AQ_DEPTH=32"
      ]
    },
    {
      "dot": "violet",
      "title": "完成侧门铃",
      "items": [
        "nvme_handle_cqe 用 command_id 找回 request，AEN 走特判分支",
        "nvme_complete_rq → nvme_end_req → blk_mq_end_request 完成回收",
        "处理完 CQE 后 nvme_update_cq_head，再写 CQ head doorbell 归还槽位"
      ]
    },
    {
      "dot": "slate",
      "title": "完整调用链(源码核实)",
      "items": [
        "nvme_queue_rq—drivers/nvme/host/pci.c:1663",
        "nvme_prep_rq—drivers/nvme/host/pci.c:1626",
        "nvme_setup_cmd—drivers/nvme/host/core.c:1107",
        "nvme_sq_copy_cmd—drivers/nvme/host/pci.c:742",
        "nvme_write_sq_db—drivers/nvme/host/pci.c:724",
        "nvme_irq—drivers/nvme/host/pci.c:1862",
        "nvme_poll_cq—drivers/nvme/host/pci.c:1841",
        "nvme_handle_cqe—drivers/nvme/host/pci.c:1789",
        "nvme_update_cq_head—drivers/nvme/host/pci.c:1829",
        "nvme_ring_cq_doorbell—drivers/nvme/host/pci.c:1773",
        "nvme_pci_complete_rq—drivers/nvme/host/pci.c:1754",
        "nvme_complete_rq—drivers/nvme/host/core.c:513"
      ]
    }
  ]
