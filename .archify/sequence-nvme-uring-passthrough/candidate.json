  "cards": [
    {
      "dot": "emerald",
      "title": "正常路径",
      "items": [
        "SQE128 携带 struct nvme_uring_cmd,由 io_uring 分发到 f_op->uring_cmd",
        "驱动构造 nvme_command,映射用户缓冲后异步提交",
        "设备回 CQE,驱动在 end_io 中回填 status/result"
      ]
    },
    {
      "dot": "amber",
      "title": "校验门禁",
      "items": [
        "cmd.common.flags 非 0 直接 -EINVAL",
        "nsid 必须与命名空间匹配,且命令需通过 nvme_cmd_allowed",
        "写类命令要求文件以 FMODE_WRITE 打开"
      ]
    },
    {
      "dot": "violet",
      "title": "完成语义",
      "items": [
        "IOPOLL 同环上下文可内联完成,否则走 task_work",
        "pdu 保存 bio/req,完成后卸载用户映射",
        "返回 -EIOCBQUEUED 表示请求已异步排队"
      ]
    }
  ]
