  "cards": [
    {
      "dot": "cyan",
      "title": "命中路径",
      "items": [
        "filemap_get_pages 命中 page cache 时直接返回缓存 folio",
        "命中路径不触发 submit_bio,也不分配新 folio"
      ]
    },
    {
      "dot": "orange",
      "title": "缺失路径",
      "items": [
        "页缺失时先 page_cache_sync_ra 同步预读",
        "filemap_create_folio 分配 folio,read_folio 回调构造 bio",
        "submit_bio 提交读请求,磁盘完成数据读入并置 uptodate"
      ]
    },
    {
      "dot": "emerald",
      "title": "返回用户态",
      "items": [
        "filemap_read 用 copy_folio_to_iter 把数据拷贝到用户空间",
        "最终返回已读字节数"
      ]
    }
  ]
