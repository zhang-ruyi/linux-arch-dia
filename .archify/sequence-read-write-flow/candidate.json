  "cards": [
    {
      "dot": "cyan",
      "title": "读路径",
      "items": [
        "read 系统调用经 ksys_read() 进入 vfs_read()",
        "VFS 通过 file->f_op->read_iter 调用 ext4_file_read_iter()",
        "ext4 交给 generic_file_read_iter()/filemap_read() 使用页缓存"
      ]
    },
    {
      "dot": "rose",
      "title": "命中与未命中",
      "items": [
        "页缓存命中时直接把数据拷贝到用户缓冲区",
        "未命中时触发 readahead，并通过 submit_bio 读取块设备",
        "块设备返回后填充 folio，再完成用户缓冲区拷贝"
      ]
    },
    {
      "dot": "slate",
      "title": "完整调用链(源码核实)",
