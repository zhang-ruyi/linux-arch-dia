  "cards": [
    {
      "dot": "cyan",
      "title": "入口与分发",
      "items": [
        "用户态执行 syscall 指令后，CPU 进入 entry_SYSCALL_64，并在内核栈构造 pt_regs",
        "do_syscall_64() 调用 do_syscall_x64()，在当前版本由 x64_sys_call() 按系统调用号分发",
        "sys_call_table[] 仍保留系统调用地址，供 trace_syscalls 等使用，不再作为主分发路径"
      ]
    },
    {
      "dot": "emerald",
      "title": "以 read 为例",
      "items": [
        "__x64_sys_read() 调用 ksys_read()，再进入 vfs_read()",
        "vfs_read() 通过 file->f_op->read_iter() 调用到具体文件系统",
        "读取结果写入 regs->ax，并沿调用链返回用户态"
      ]
    },
    {
      "dot": "amber",
      "title": "返回路径",
      "items": [
        "do_syscall_64() 内调用 syscall_exit_to_user_mode() 处理退出工作",
        "返回值通过 SYSRET 快速返回，条件不满足时走 IRET 慢路径",
        "换页表、恢复寄存器后回到 libc，最终返回用户进程"
      ]
    }
  ]
}