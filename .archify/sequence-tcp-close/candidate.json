    {
      "dot": "emerald",
      "title": "四次挥手",
      "items": [
        "主动方 close() 后由 tcp_send_fin() 发送 FIN",
        "被动方回 ACK,应用读到 EOF 后再 close() 发送 FIN",
        "主动方回 ACK 后进入 TIME_WAIT"
      ]
    },
    {
      "dot": "violet",
      "title": "状态迁移",
      "items": [
        "主动方 FIN_WAIT_1 → FIN_WAIT_2 → TIME_WAIT → CLOSED",
        "被动方 CLOSE_WAIT → LAST_ACK → CLOSED"
      ]
    },
    {
      "dot": "amber",
      "title": "TIME_WAIT",
      "items": [
        "主动方等待 2MSL 后释放连接",
        "该等待保证迟到的报文不会污染新连接"
      ]
    },
