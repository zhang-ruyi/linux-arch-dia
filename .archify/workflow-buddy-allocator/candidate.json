  "cards": [
    {
      "dot": "cyan",
      "title": "分配两条路径",
      "items": [
        "rmqueue 先尝试每 CPU 页表 rmqueue_pcplist",
        "大 order 或 PCP 不足时进入 __rmqueue 伙伴慢路径",
        "__rmqueue_smallest 从最低阶取出,expand 把剩余块回插伙伴表"
      ]
    },
    {
      "dot": "emerald",
      "title": "释放两条路径",
      "items": [
        "__free_frozen_pages 可把单页回填 PCP 页表",
        "大 order 走 __free_pages_ok → free_one_page → __free_one_page",
        "PCP 满后批量释放最终也进入 __free_one_page 向上合并伙伴"
      ]
    }
  ]
