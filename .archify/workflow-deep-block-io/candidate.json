  "cards": [
    {
      "dot": "slate",
      "title": "读图要点",
      "items": [
        "节点是内核函数，按 bio 提交 → blk-mq 入队 → 派发到驱动 → 完成回收四阶段分组",
        "blk_mq_submit_bio 在 plug 缓存未命中时分配新请求，插入软件队列后由 blk_mq_run_hw_queue 触发派发",
        "完成侧经 blk_mq_complete_request 的远端/软中断重定向，最终由 blk_update_request 调用 bio_endio"
      ]
    }
  ]
