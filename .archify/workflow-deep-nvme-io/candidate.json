  "cards": [
    {
      "dot": "cyan",
      "title": "提交准备",
      "items": [
        "nvme_queue_rq 先做队列/控制器就绪检查，再进入 nvme_prep_rq",
        "nvme_prep_rq 调用 nvme_setup_cmd 按 req_op 分派命令构造",
        "读写路径由 nvme_setup_rw 填充 SQE 字段"
      ]
    },
    {
      "dot": "emerald",
      "title": "映射与门铃",
      "items": [
        "nvme_map_data 构建 PRP/SGL，完整性场景再映射元数据",
        "nvme_sq_copy_cmd 把 64B SQE 拷贝到主机提交队列",
        "nvme_write_sq_db 在 sq_lock 下写 SQ tail 门铃；批量路径由 nvme_submit_cmds 合并",
        "本节函数均位于 drivers/nvme/host/pci.c"
      ]
    },
    {
      "dot": "violet",
      "title": "完成中断",
      "items": [
        "nvme_irq → nvme_poll_cq 遍历 CQ，nvme_cqe_pending 用 phase 判断有效性",
        "nvme_handle_cqe 特判 AEN，否则按 command_id 由 nvme_find_rq 找回请求",
        "nvme_update_cq_head 推进头指针，nvme_ring_cq_doorbell 归还 CQ 槽位"
      ]
    },
    {
      "dot": "rose",
      "title": "收尾",
      "items": [
        "nvme_try_complete_req 回填后分流到 nvme_pci_complete_rq 或批量回调",
        "nvme_complete_rq → __nvme_complete_rq → nvme_cleanup_cmd → nvme_decide_disposition",
        "COMPLETE 经 nvme_end_req → blk_mq_end_request → bio_endio 逐层返回"
      ]
    }
  ]
}