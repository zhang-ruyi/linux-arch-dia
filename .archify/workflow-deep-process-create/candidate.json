  "cards": [
    {
      "dot": "slate",
      "title": "函数级调用链",
      "items": [
        "fork() → kernel_clone() → copy_process()",
        "copy_process() → dup_task_struct() / copy_files() / copy_mm() / copy_thread()",
        "copy_mm() → dup_mm() → mm_init() / dup_mmap() → copy_page_range()",
        "kernel_clone() 在 copy_process() 返回后调用 wake_up_new_task()"
      ]
    },
    {
      "dot": "emerald",
      "title": "唤醒与入队",
      "items": [
        "wake_up_new_task() 将子进程状态置为 TASK_RUNNING",
        "select_task_rq_fair() 选择目标 CPU 后 activate_task() 入队",
        "enqueue_task_fair() → place_entity() 计算虚拟截止时间"
      ]
    },
    {
      "dot": "amber",
      "title": "未展开的同级复制",
      "items": [
        "copy_fs()、copy_sighand()、copy_signal()、copy_namespaces()、copy_io() 同属 copy_process() 直接调用",
        "这些分支为可读性省略，调用顺序见 copy_process() 源码 2277-2298 行"
      ]
    }
  ]
