  "cards": [
    {
      "dot": "cyan",
      "title": "上半部",
      "items": [
        "硬件触发中断后经 IDT 进入 common_interrupt()",
        "generic_handle_irq() 找到 irq_desc，调用 request_irq() 注册的 action",
        "__handle_irq_event_percpu() 逐个执行 action，并记录返回值"
      ]
    },
    {
      "dot": "emerald",
      "title": "下半部",
      "items": [
        "irq_exit_rcu() 发现 pending 软中断后调用 do_softirq()",
        "softirq 执行 open_softirq() 注册的 action；tasklet 由 tasklet_action() 运行",
        "workqueue 通过 queue_work() 提交，由 worker_thread() 在进程上下文执行"
      ]
    },
    {
      "dot": "amber",
      "title": "返回与调度",
      "items": [
        "irqentry_exit() 负责中断返回路径",
        "返回前若 need_resched() 为真，preempt_schedule_irq() 触发调度",
        "软中断与 workqueue 都可运行于进程上下文或内核线程，workqueue 允许睡眠"
      ]
    }
  ]
}
