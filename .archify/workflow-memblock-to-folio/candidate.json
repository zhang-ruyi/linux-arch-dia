  "cards": [
    {
      "dot": "cyan",
      "title": "启动期 memblock",
      "items": [
        "memblock_add 登记架构探测到的可用物理内存区间",
        "memblock_reserve 保留内核、固件、设备等不可用区域",
        "memblock_alloc 在伙伴系统就绪前提供启动期物理分配"
      ]
    },
    {
      "dot": "emerald",
      "title": "移交伙伴系统",
      "items": [
        "memblock_free_all 把未保留的 memblock 区间释放给伙伴系统",
        "free_area_init 建立 zone、迁移类型与空闲链表",
        "mem_init 完成页表与内存统计初始化"
      ]
    },
    {
      "dot": "violet",
      "title": "运行时分配",
      "items": [
        "PCP 以 per_cpu_pages 缓存页块,减少 zone 锁竞争",
        "SLUB 从伙伴系统取页作为 slab,再切分为对象",
        "page cache 与匿名页都以 struct folio 管理,THP 使用更高 order"
      ]
    },
    {
      "dot": "slate",
      "title": "源码索引",
      "items": [
