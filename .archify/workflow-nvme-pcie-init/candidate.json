        "nvme_pci_configure_admin_queue — drivers/nvme/host/pci.c:2332",
        "nvme_enable_ctrl — drivers/nvme/host/core.c:2744",
        "nvme_init_ctrl_finish — drivers/nvme/host/core.c:3736",
        "nvme_init_identify — drivers/nvme/host/core.c:3589",
        "nvme_setup_io_queues — drivers/nvme/host/pci.c:2944",
        "nvme_create_io_queues — drivers/nvme/host/pci.c:2410",
        "nvme_start_ctrl — drivers/nvme/host/core.c:5064"
      ]
    }
  ]
