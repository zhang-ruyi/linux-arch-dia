  "cards": [
    {
      "dot": "cyan",
      "title": "队列深度",
      "items": [
        "io_queue_depth 默认 1024,允许范围 2..4095",
        "q_depth = min(NVME_CAP_MQES + 1, io_queue_depth)",
        "NVME_AQ_DEPTH 固定为 32,管理队列按 32 项分配",
        "QDEPTH_ONE→2;PM1725→64;SHARED_TAGS 下限 34"
      ]
    },
    {
      "dot": "rose",
      "title": "启动语义",
      "items": [
        "nvme_start_ctrl 先启用 AEN,再 queue scan",
        "LIVE 状态下 unquiesce I/O 队列并更新多路径",
        "scan_work 仅在 LIVE 且 tagset 存在时扫描命名空间"
      ]
    },
    {
      "dot": "slate",
      "title": "完整调用链(源码核实)",
      "items": [
        "nvme_init — drivers/nvme/host/pci.c:4309",
        "pci_register_driver — drivers/nvme/host/pci.c:4316",
        "nvme_probe — drivers/nvme/host/pci.c:3747",
