  "cards": [
    {
      "dot": "cyan",
      "title": "分发主干",
      "items": [
        "exc_page_fault 读取 CR2 后进入 handle_page_fault",
        "do_user_addr_fault 查找 VMA 后交给 handle_mm_fault",
        "__handle_mm_fault 逐级补齐页表,最终由 handle_pte_fault 按 PTE 状态分发"
      ]
    },
    {
      "dot": "rose",
      "title": "四条 PTE 分支",
      "items": [
        "PTE 为空走 do_pte_missing,再按匿名或文件映射分流",
        "swap 项走 do_swap_page,NUMA 保护页走 do_numa_page",
        "写只读页走 do_wp_page 完成 COW"
      ]
    },
    {
      "dot": "emerald",
      "title": "文件缺页收敛",
      "items": [
        "只读、私有写、共享写分别进入 do_read_fault、do_cow_fault、do_shared_fault",
        "三者统一经 __do_fault 调用 vm_ops->fault",
        "filemap_fault 负责从磁盘读入文件页"
      ]
    },
    {
      "dot": "slate",
      "title": "完整调用链(源码核实)",
      "items": [
