  "cards": [
    {
      "dot": "cyan",
      "title": "回收主干",
      "items": [
        "内存压力通过 wakeup_kswapd 唤醒 kswapd 内核线程",
        "balance_pgdat → shrink_node → shrink_node_memcgs 逐层进入节点与 cgroup",
        "shrink_lruvec 按比例调用 shrink_list,区分 active 与 inactive LRU"
      ]
    },
    {
      "dot": "rose",
      "title": "LRU 分支",
      "items": [
        "active LRU 由 shrink_active_list 降级后回到 shrink_list",
        "inactive LRU 由 shrink_inactive_list 隔离并交给 shrink_folio_list"
      ]
    },
    {
      "dot": "emerald",
      "title": "四种回收去向",
      "items": [
        "干净文件页直接回收并回到伙伴系统",
        "匿名页经 pageout 与 swap_writeout 换出,最终由 __swap_writepage 写入交换设备",
        "shmem 脏页走 shmem_writeout,文件脏页走页面 writeback"
      ]
    },
    {
      "dot": "slate",
      "title": "完整调用链(源码核实)",
      "items": [
        "kswapd — mm/vmscan.c:7399",
        "balance_pgdat — mm/vmscan.c:7064",
        "shrink_node — mm/vmscan.c:6146",
        "shrink_node_memcgs — mm/vmscan.c:6067",
        "shrink_lruvec — mm/vmscan.c:5876",
        "shrink_list — mm/vmscan.c:2215",
        "shrink_active_list — mm/vmscan.c:2068 (active LRU)",
        "shrink_inactive_list — mm/vmscan.c:1986 (inactive LRU)",
        "shrink_folio_list — mm/vmscan.c:1055",
        "pageout — mm/vmscan.c:618",
        "swap_writeout — mm/page_io.c:251 (匿名页)",
        "__swap_writepage — mm/page_io.c:466",
        "shmem_writeout — mm/shmem.c:1591 (shmem 脏页)"
      ]
    }
  ]
