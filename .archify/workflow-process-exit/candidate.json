  "cards": [
    {
      "dot": "amber",
      "title": "僵尸态",
      "items": [
        "已退出但尚未被父进程 wait() 回收",
        "保留 task_struct 与退出码，地址空间等资源已释放",
        "父进程需调用 wait()/wait4() 才能完成回收"
      ]
    },
    {
      "dot": "cyan",
      "title": "完整回收路径",
      "items": [
        "do_exit() → exit_signals() → exit_mm() → exit_files()",
        "exit_notify() → do_notify_parent() 向父进程发送 SIGCHLD",
        "父进程 do_wait() → wait_consider_task() → wait_task_zombie()",
        "release_task() 释放 task_struct，进程彻底消亡"
      ]
    },
    {
      "dot": "slate",
      "title": "完整调用链(源码核实)",
      "items": [
        "do_exit() — kernel/exit.c:929",
