        "exit_mm() — kernel/exit.c:581",
        "exit_files() — fs/file.c:518",
        "exit_notify() — kernel/exit.c:771",
        "do_notify_parent() — kernel/signal.c:2175",
        "do_wait() — kernel/exit.c:1744",
        "wait_consider_task() — kernel/exit.c:1487",
        "wait_task_zombie() — kernel/exit.c:1207",
        "release_task() — kernel/exit.c:249"
      ]
    }
