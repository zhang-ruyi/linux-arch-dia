  "cards": [
    {
      "dot": "cyan",
      "title": "脏页产生与节流",
      "items": [
        "write() 通过页缓存写入并标记 folio 为脏",
        "balance_dirty_pages() 在超过阈值时节流写进程",
        "回写工作由 bdi_writeback 内核线程推进"
      ]
    },
    {
      "dot": "emerald",
      "title": "回写与完成",
      "items": [
        "writeback_sb_inodes() 遍历超级块上的脏 inode",
        "__writeback_single_inode() 调用 address_space->writepages",
        "ext4_writepages() 生成并提交 bio，完成后清除脏标志"
